# Copy this file to `.env` in the repo root and fill in whatever you need.
# Every value below is OPTIONAL - SwingTrader runs with zero configuration.
# See README.md > "Do I need an API key?" for the full explanation.

# Enables real-time quotes on the live screener via Finnhub. Get a free key
# at https://finnhub.io/register (no credit card required). Leave unset and
# the screener falls back to Yahoo Finance (yfinance) data automatically -
# it still works, just without Finnhub's real-time quote layer.
# FINNHUB_API_KEY=

# Comma-separated browser origins allowed to call the API. The default
# already covers the Vite dev server (http://localhost:5173) - only change
# this if you're hosting the frontend somewhere else.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where cached price data (Parquet files) is read from.
# DATA_DIR=data/raw

# Whether the API may fetch an uncached ticker live from Yahoo Finance.
# Set to false to run fully offline against only what's already cached.
# ALLOW_DOWNLOADS=true

# Where the live screener reads its ticker universe from, one symbol per
# line.
# WATCHLIST_PATH=config/watchlist.txt

# Hard cap on tickers scanned per screener call - raise this if your
# watchlist file has more names than the default cap (a truncation warning
# shows up in the screener response's `warnings` if it's ever hit).
# SCREENER_MAX_TICKERS=750

# Thread-pool size used to fetch tickers concurrently - also the de facto
# rate limit against the data provider.
# SCREENER_MAX_WORKERS=16

# Minimum trailing average daily volume (shares) for a ticker to be scanned
# at all; below this it's skipped as VOLUME_FILTER_FAILED.
# SCREENER_MIN_AVG_VOLUME=100000

# Trailing bar count SCREENER_MIN_AVG_VOLUME is averaged over.
# SCREENER_VOLUME_LOOKBACK=20

# Skip a ticker as DATA_STALE if its most recent cached bar is older than
# this many days. Unset disables the check.
# SCREENER_STALE_AFTER_DAYS=

# Where the trade journal (entries/exits/decay analytics) reads and writes
# its CSV.
# JOURNAL_PATH=data/trades_live.csv

# Telegram alert channel - both must be set for it to activate. Create a bot
# via @BotFather for the token; the chat id is whoever/wherever should
# receive setup alerts.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Discord alert channel - an incoming webhook URL from a channel's
# Integrations settings. Unset disables it.
# DISCORD_WEBHOOK_URL=

# Generic HTTP alert channel - setups are POSTed here as flat JSON. Unset
# disables it.
# GENERIC_WEBHOOK_URL=

# Alpaca paper-trading credentials (https://alpaca.markets - the free paper
# account, not a live brokerage account). Both must be set for the
# /api/v1/execution/* endpoints to work; the SDK is always pointed at
# Alpaca's paper endpoint regardless of these values - there is no setting
# that makes this platform place live orders.
# ALPACA_API_KEY=
# ALPACA_API_SECRET=

# Multi-provider data fallback cascade (quant/data/provider_fallback.py) -
# tried in order after the local Parquet cache and yfinance both miss.
# Each is skipped entirely (not attempted) if its key is unset.
# FMP_API_KEY=
# ALPHA_VANTAGE_API_KEY=
# POLYGON_API_KEY=
