-import pandas as pd
-import numpy as np
-from pathlib import Path
-from datetime import datetime
-
-DATA_DIR = Path("data/raw")
-WATCHLIST_FILE = Path("watchlist.txt")
-
-# ============================================================
-# CONFIG
-# ============================================================
-
-START_DATE = "2015-01-01"
-INITIAL_CAPITAL = 100000  # £100k starting capital
-RISK_PER_TRADE = 0.01  # 1% risk per trade
-MAX_POSITION_SIZE = 0.05  # Max 5% per stock
-
-# SuperTrend parameters
-ATR_PERIOD = 10
-ATR_MULTIPLIER = 3.0
-EMA_PERIOD = 50
-
-
-# ============================================================
-# INDICATORS
-# ============================================================
-
-
-def calculate_atr(df, period=14):
-    """Calculate Average True Range"""
-    df = df.copy()
-
-    df["high_low"] = df["High"] - df["Low"]
-    df["high_close"] = abs(df["High"] - df["Close"].shift())
-    df["low_close"] = abs(df["Low"] - df["Close"].shift())
-
-    df["tr"] = df[["high_low", "high_close", "low_close"]].max(axis=1)
-    df["atr"] = df["tr"].rolling(window=period).mean()
-
-    return df["atr"]
-
-
-def calculate_supertrend(df, atr_period=10, multiplier=3.0):
-    """Calculate SuperTrend indicator - simplified"""
-    df = df.copy()
-
-    # Calculate ATR
-    df["atr"] = calculate_atr(df, atr_period)
-    df["atr"] = df["atr"].bfill().fillna(df["atr"].mean())
-
-    df["hl_avg"] = (df["High"] + df["Low"]) / 2
-
-    # Basic bands
-    df["basic_ub"] = df["hl_avg"] + multiplier * df["atr"]
-    df["basic_lb"] = df["hl_avg"] - multiplier * df["atr"]
-
-    # Use numpy arrays for speed
-    close = df["Close"].values
-    basic_ub = df["basic_ub"].values
-    basic_lb = df["basic_lb"].values
-
-    final_ub = np.zeros(len(df))
-    final_lb = np.zeros(len(df))
-
-    final_ub[0] = basic_ub[0]
-    final_lb[0] = basic_lb[0]
-
-    for i in range(1, len(df)):
-        # Upper band
-        if basic_ub[i] < final_ub[i - 1] or close[i - 1] > final_ub[i - 1]:
-            final_ub[i] = basic_ub[i]
-        else:
-            final_ub[i] = final_ub[i - 1]
-
-        # Lower band
-        if basic_lb[i] > final_lb[i - 1] or close[i - 1] < final_lb[i - 1]:
-            final_lb[i] = basic_lb[i]
-        else:
-            final_lb[i] = final_lb[i - 1]
-
-    df["final_ub"] = final_ub
-    df["final_lb"] = final_lb
-
-    # Determine trend
-    trend = np.zeros(len(df))
-    supertrend = np.zeros(len(df))
-    trend[0] = 1
-    supertrend[0] = final_lb[0]
-
-    for i in range(1, len(df)):
-        if trend[i - 1] == 1:
-            if close[i] <= final_lb[i]:
-                trend[i] = -1
-                supertrend[i] = final_ub[i]
-            else:
-                trend[i] = 1
-                supertrend[i] = final_lb[i]
-        else:
-            if close[i] >= final_ub[i]:
-                trend[i] = 1
-                supertrend[i] = final_lb[i]
-            else:
-                trend[i] = -1
-                supertrend[i] = final_ub[i]
-
-    df["trend"] = trend
-    df["supertrend"] = supertrend
-
-    # Generate signals
-    signals = np.zeros(len(df))
-    for i in range(1, len(df)):
-        if trend[i] != trend[i - 1]:
-            signals[i] = 1 if trend[i] == 1 else -1
-
-    df["st_signal"] = signals
-
-    return df
-
-
-def calculate_ema(df, period=50):
-    """Calculate Exponential Moving Average"""
-    return df["Close"].ewm(span=period, adjust=False).mean()
-
-
-# ============================================================
-# BACKTEST
-# ============================================================
-
-
-def backtest_ticker(ticker, df, debug=False):
-    """Backtest SuperTrend on single ticker"""
-
-    if df is None or len(df) < 100:
-        return None
-
-    df = calculate_supertrend(df, ATR_PERIOD, ATR_MULTIPLIER)
-    df["ema50"] = calculate_ema(df, EMA_PERIOD)
-
-    # Debug: Check signals
-    if debug:
-        buy_signals = (df["st_signal"] == 1).sum()
-        sell_signals = (df["st_signal"] == -1).sum()
-        print(
-            f"  DEBUG {ticker}: Buy signals: {buy_signals}, Sell signals: {sell_signals}"
-        )
-        if buy_signals > 0:
-            print(f"    First buy at index {df[df['st_signal'] == 1].index[0]}")
-
-    # Trading logic
-    trades = []
-    position = None
-    entry_price = 0
-    entry_date = None
-
-    for i in range(EMA_PERIOD, len(df)):
-        close = df["Close"].iloc[i]
-        date = df.index[i]
-        signal = df["st_signal"].iloc[i]
-        atr = df["atr"].iloc[i]
-
-        # Buy signal
-        if signal == 1 and position is None:
-            entry_price = close
-            entry_date = date
-            position = "long"
-            stop_loss = close - (ATR_MULTIPLIER * atr)
-            take_profit = close + (ATR_MULTIPLIER * atr)
-
-        # Exit signal
-        elif signal == -1 and position == "long":
-            exit_price = close
-            profit = exit_price - entry_price
-            profit_pct = (profit / entry_price) * 100
-
-            trades.append(
-                {
-                    "ticker": ticker,
-                    "entry_date": entry_date,
-                    "exit_date": date,
-                    "entry_price": round(entry_price, 2),
-                    "exit_price": round(exit_price, 2),
-                    "profit": round(profit, 2),
-                    "profit_pct": round(profit_pct, 2),
-                    "days_held": (date - entry_date).days,
-                }
-            )
-
-            position = None
-
-    if not trades:
-        return {
-            "ticker": ticker,
-            "trades": 0,
-            "win_rate": 0,
-            "avg_profit": 0,
-            "total_profit": 0,
-        }
-
-    # Convert to DataFrame and ensure numeric types
-    trades_df = pd.DataFrame(trades)
-    trades_df["profit"] = pd.to_numeric(trades_df["profit"], errors="coerce")
-    trades_df["profit_pct"] = pd.to_numeric(trades_df["profit_pct"], errors="coerce")
-    trades_df["days_held"] = pd.to_numeric(trades_df["days_held"], errors="coerce")
-
-    # Remove any NaN rows
-    trades_df = trades_df.dropna(subset=["profit"])
-
-    if len(trades_df) == 0:
-        return {
-            "ticker": ticker,
-            "trades": 0,
-            "win_rate": 0,
-            "avg_profit": 0,
-            "total_profit": 0,
-        }
-
-    winning_trades = (trades_df["profit"] > 0).sum()
-    total_trades = len(trades_df)
-    win_rate = (winning_trades / total_trades * 100) if total_trades > 0 else 0
-
-    return {
-        "ticker": ticker,
-        "trades": total_trades,
-        "win_rate": round(win_rate, 1),
-        "avg_profit": round(trades_df["profit"].mean(), 2),
-        "total_profit": round(trades_df["profit"].sum(), 2),
-        "best_trade": round(trades_df["profit"].max(), 2),
-        "worst_trade": round(trades_df["profit"].min(), 2),
-        "avg_hold_days": round(trades_df["days_held"].mean(), 1),
-    }
-
-
-def load_from_cache(ticker):
-    """Load ticker data from local parquet cache"""
-    parquet_path = DATA_DIR / f"{ticker}.parquet"
-
-    if not parquet_path.exists():
-        return None
-
-    try:
-        df = pd.read_parquet(parquet_path)
-        df = df[df.index >= START_DATE]
-        return df
-    except:
-        return None
-
-
-def backtest_all_stocks():
-    """Backtest all stocks in watchlist"""
-
-    # Load watchlist
-    if not WATCHLIST_FILE.exists():
-        print(f"❌ {WATCHLIST_FILE} not found")
-        return
-
-    with open(WATCHLIST_FILE, "r") as f:
-        tickers = [
-            line.strip().upper()
-            for line in f
-            if line.strip() and not line.startswith("#")
-        ]
-
-    print()
-    print("=" * 70)
-    print("SUPERTREND BACKTEST (500 STOCKS)")
-    print("=" * 70)
-    print(f"Period: {START_DATE} → today")
-    print(f"ATR Period: {ATR_PERIOD}, Multiplier: {ATR_MULTIPLIER}")
-    print(f"Initial Capital: £{INITIAL_CAPITAL:,.0f}")
-    print("=" * 70)
-    print()
-
-    results = []
-    skipped = 0
-
-    for i, ticker in enumerate(tickers, 1):
-        df = load_from_cache(ticker)
-
-        if df is None or len(df) < 100:
-            skipped += 1
-            continue
-
-        # Debug first 5 stocks
-        debug_mode = i <= 5
-
-        result = backtest_ticker(ticker, df, debug=debug_mode)
-
-        if result and result["trades"] > 0:
-            results.append(result)
-            print(
-                f"[{i:3d}/{len(tickers)}] {ticker:<6} "
-                f"Trades: {result['trades']:3d} | "
-                f"Win%: {result['win_rate']:5.1f}% | "
-                f"Avg: £{result['avg_profit']:7.2f} | "
-                f"Total: £{result['total_profit']:10.2f}"
-            )
-
-    print()
-    print("=" * 70)
-    print("SUMMARY")
-    print("=" * 70)
-
-    if len(results) == 0:
-        print("❌ No trades generated. Check SuperTrend parameters.")
-        return
-
-    results_df = pd.DataFrame(results)
-
-    total_trades = results_df["trades"].sum()
-    avg_win_rate = results_df["win_rate"].mean()
-    total_profit = results_df["total_profit"].sum()
-    profitable_stocks = len(results_df[results_df["total_profit"] > 0])
-
-    print(f"Stocks with trades: {len(results)}")
-    print(f"Stocks skipped: {skipped}")
-    print(f"Total trades: {total_trades}")
-    print(f"Average win rate: {avg_win_rate:.1f}%")
-    print(f"Total profit (all stocks): £{total_profit:,.2f}")
-    print(f"Profitable stocks: {profitable_stocks}/{len(results)}")
-    print()
-
-    if len(results) > 0:
-        print("TOP 10 BY PROFIT")
-        print("-" * 70)
-        top10 = results_df.nlargest(10, "total_profit")
-        for _, row in top10.iterrows():
-            print(
-                f"  {row['ticker']:<6} "
-                f"Trades: {row['trades']:3d} | "
-                f"Win%: {row['win_rate']:5.1f}% | "
-                f"Profit: £{row['total_profit']:10.2f}"
-            )
-
-        print()
-        print("WORST 10 BY PROFIT")
-        print("-" * 70)
-        worst10 = results_df.nsmallest(10, "total_profit")
-        for _, row in worst10.iterrows():
-            print(
-                f"  {row['ticker']:<6} "
-                f"Trades: {row['trades']:3d} | "
-                f"Win%: {row['win_rate']:5.1f}% | "
-                f"Profit: £{row['total_profit']:10.2f}"
-            )
-
-    # Save results
-    results_df.to_csv("backtest_results.csv", index=False)
-    print()
-    print(f"📄 Results saved to: backtest_results.csv")
-    print("=" * 70)
-    print()
-
-
-if __name__ == "__main__":
-    backtest_all_stocks()
